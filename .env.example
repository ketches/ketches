# Server Configuration
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# Database Configuration
# Supported runtime drivers: postgres, mysql
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ketches
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=disable
# MySQL only. Use true or a registered verified TLS profile outside local development.
DB_TLS=

# Optional: use DB_SOURCE to override the generated connection string directly.
# DB_SOURCE=host=localhost port=5432 user=postgres password=<db-password> dbname=ketches sslmode=disable
# Disable only when schema changes are managed by a separate migration process.
DB_AUTO_MIGRATE=true

# PostgreSQL example:
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ketches
# DB_USERNAME=postgres
# DB_PASSWORD=<db-password>
# DB_SSLMODE=disable

# MySQL example:
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=ketches
# DB_USERNAME=root
# DB_PASSWORD=<db-password>

# JWT Configuration
# Required. Use a strong random secret. The API will refuse to start if unset.
JWT_SECRET=

# Secret Encryption Configuration
# Required. Used to encrypt sensitive values such as kubeconfig blobs and registry passwords at rest.
# Use at least 32 random bytes. The API will refuse to start if unset or too short.
SECRET_ENCRYPTION_KEY=

# Bootstrap administrator settings.
# Ketches always creates a bootstrap admin when no admin exists.
# BOOTSTRAP_ADMIN_USERNAME overrides the default username `kadmin`.
# BOOTSTRAP_ADMIN_PASSWORD is required at startup and must be delivered as a secret.
# Generate a random value with: openssl rand -base64 24
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Sign-up email verification
# true by default. Set to false to allow public sign-up without requesting an email verification code.
SIGN_UP_EMAIL_VERIFICATION_REQUIRED=true

# SMTP Configuration
# Required when sign-up email verification is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# CORS Configuration
# Multiple origins separated by comma
# Examples:
#   Development (allow localhost):
#     CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
#   
#   Production (specific domains):
#     CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
#   
#   Wildcard subdomain:
#     CORS_ALLOWED_ORIGINS=https://*.example.com
#   
#   Development only (allow all - NOT recommended for production):
#     CORS_ALLOWED_ORIGINS=*
#
# If not set, defaults to common development ports
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Comma-separated proxy IPs/CIDRs whose forwarding headers may define the client IP.
# Leave empty when the API is not behind a trusted reverse proxy.
TRUSTED_PROXIES=

# Optional comma-separated exact hosts or wildcard subdomains (for example api.openai.com,*.github.com).
# When empty, any public host is allowed; private, loopback, link-local, and metadata addresses remain blocked.
EGRESS_ALLOWED_HOSTS=
# Optional comma-separated old encryption keys used only to decrypt data during key rotation.
PREVIOUS_SECRET_ENCRYPTION_KEYS=
# Disabled by default because hostPath grants workloads access to node filesystems.
ALLOW_HOSTPATH_VOLUMES=false
