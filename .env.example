# Server Configuration
PORT=8080
LOG_LEVEL=info

# Database Configuration
# Supported runtime drivers: postgres, mysql
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ketches
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=disable

# Optional: use DB_SOURCE to override the generated connection string directly.
# DB_SOURCE=host=localhost port=5432 user=postgres password=<db-password> dbname=ketches sslmode=disable
# DB_AUTO_MIGRATE controls whether AutoMigrate runs at startup.
# true by default. Set to false in environments where schema changes are managed externally.
DB_AUTO_MIGRATE=true

# PostgreSQL example:
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ketches
# DB_USERNAME=postgres
# DB_PASSWORD=<db-password>
# DB_SSLMODE=disable

# MySQL example:
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=ketches
# DB_USERNAME=root
# DB_PASSWORD=<db-password>

# JWT Configuration
# Required. Use a strong random secret. The API will refuse to start if unset.
JWT_SECRET=

# Secret Encryption Configuration
# Required. Used to encrypt sensitive values such as kubeconfig blobs and registry passwords at rest.
# Use a strong random secret. The API will refuse to start if unset.
SECRET_ENCRYPTION_KEY=

# Bootstrap administrator settings.
# Ketches always creates a bootstrap admin when no admin exists.
# BOOTSTRAP_ADMIN_USERNAME overrides the default username `kadmin`.
# BOOTSTRAP_ADMIN_PASSWORD is required at startup and must be delivered as a secret.
# Generate a random value with: openssl rand -base64 24
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Sign-up email verification
# true by default. Set to false to allow public sign-up without requesting an email verification code.
SIGN_UP_EMAIL_VERIFICATION_REQUIRED=true

# SMTP Configuration
# Required when sign-up email verification is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# CORS Configuration
# Multiple origins separated by comma
# Examples:
#   Development (allow localhost):
#     CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
#   
#   Production (specific domains):
#     CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
#   
#   Wildcard subdomain:
#     CORS_ALLOWED_ORIGINS=https://*.example.com
#   
#   Development only (allow all - NOT recommended for production):
#     CORS_ALLOWED_ORIGINS=*
#
# If not set, defaults to common development ports
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Builder Configuration
# Optional base URL for the Builder agent service.
BUILDER_AGENT_BASE_URL=
# Optional API key used when calling the Builder agent service.
BUILDER_AGENT_API_KEY=
# Optional model name requested from the Builder agent service.
BUILDER_AGENT_MODEL=
# Workspace container image used for Builder sessions.
# Leave blank to use the built-in default: node:22-bookworm
BUILDER_WORKSPACE_IMAGE=
# Optional Builder execution catalog. When provided, Builder resolves executor policy and
# workspace image per run from this catalog instead of relying only on BUILDER_WORKSPACE_IMAGE.
# Example:
# BUILDER_EXECUTION_CATALOG_JSON={"image_profiles":[{"key":"node-default","image":"node:22-bookworm","capabilities":["node","npm","workspace"]}],"executor_policies":[{"key":"workspace-only","executor_kind":"workspace_pod","image_profile_key":"node-default"}],"default_image_profile_key":"node-default","default_executor_policy_key":"workspace-only"}
BUILDER_EXECUTION_CATALOG_JSON=
# Workspace root path mounted inside Builder sessions.
BUILDER_WORKSPACE_ROOT=/workspace
# Builder session time-to-live in hours.
BUILDER_SESSION_TTL_HOURS=24
