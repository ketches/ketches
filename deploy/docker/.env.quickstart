# Quickstart-only environment values for local evaluation.
# Do NOT reuse these values in shared, staging, or production environments.

POSTGRES_PASSWORD=ketches-quickstart-postgres
JWT_SECRET=ketches-quickstart-jwt-secret
SECRET_ENCRYPTION_KEY=ketches-quickstart-encryption-key
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
DB_SSLMODE=disable
SIGN_UP_EMAIL_VERIFICATION_REQUIRED=false

# Generate this value before startup; see the repository README.
# BOOTSTRAP_ADMIN_PASSWORD=
